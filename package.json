{
  "name": "pmp-wasi",
  "version": "0.1.0",
  "private": true,
  "description": "Freestanding, single-threaded WebAssembly bindings for PMP algorithms, built with wasi-sdk.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:node": "node scripts/e2e.mjs --node-only",
    "bench": "node scripts/bench.mjs",
    "fixtures": "node scripts/native-fixture.mjs",
    "size": "node scripts/size.mjs",
    "test:upstream": "node scripts/upstream-tests.mjs",
    "test:fuzz": "node scripts/fuzz.mjs",
    "tune": "node scripts/tune.mjs",
    "profile:memory": "node scripts/memory.mjs",
    "test:gltf": "node scripts/gltf-e2e.mjs",
    "test:gltf:node": "node scripts/gltf-e2e.mjs --node-only",
    "profile:gltf": "node --expose-gc scripts/gltf-profile.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "include/pmp.h",
    "DESIGN.md",
    "COMPATIBILITY.md",
    "upstream.json",
    "wasm-exports.json",
    "exports/core.json",
    "THIRD_PARTY_NOTICES.md",
    "design/pmp-proposed.h",
    "PERFORMANCE.md",
    "src/index.js",
    "src/index.d.ts",
    "src/gltf-transform.js",
    "src/gltf-transform.d.ts",
    "src/gltf/*.js",
    "GLTF_TRANSFORM.md",
    "design/gltf-transform.md"
  ],
  "keywords": [
    "pmp",
    "mesh",
    "wasm",
    "wasi-sdk",
    "geometry"
  ],
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./gltf-transform": {
      "types": "./src/gltf-transform.d.ts",
      "import": "./src/gltf-transform.js"
    }
  },
  "peerDependencies": {
    "@gltf-transform/core": "^4.5.1"
  },
  "peerDependenciesMeta": {
    "@gltf-transform/core": {
      "optional": true
    }
  }
}
