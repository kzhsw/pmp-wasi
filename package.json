{
  "name": "pmp-wasi",
  "version": "0.1.0",
  "description": "Freestanding, single-threaded WebAssembly bindings for PMP algorithms, built with wasi-sdk.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:node": "node scripts/e2e.mjs --node-only",
    "bench": "node scripts/bench.mjs",
    "fixtures": "node scripts/native-fixture.mjs",
    "size": "node scripts/size.mjs",
    "test:upstream": "node scripts/upstream-tests.mjs",
    "test:fuzz": "node scripts/fuzz.mjs",
    "tune": "node scripts/tune.mjs",
    "profile:memory": "node scripts/memory.mjs",
    "test:gltf": "node scripts/gltf-e2e.mjs",
    "test:gltf:node": "node scripts/gltf-e2e.mjs --node-only",
    "profile:gltf": "node --expose-gc scripts/gltf-profile.mjs",
    "prepack": "node scripts/package.mjs",
    "package": "node scripts/package.mjs --pack",
    "test:package": "node scripts/package-e2e.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "include/pmp.h",
    "API.md",
    "COMPATIBILITY.md",
    "PERFORMANCE.md",
    "GLTF_TRANSFORM.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "dist/pmp.wasm",
    "dist/build.json",
    "dist/licenses/",
    "licenses/runtime/",
    "src/index.js",
    "src/index.d.ts",
    "src/gltf-transform.js",
    "src/gltf-transform.d.ts",
    "src/gltf/geometry.js",
    "src/gltf/attributes.js",
    "src/gltf/transfer.js"
  ],
  "keywords": [
    "pmp",
    "mesh",
    "wasm",
    "wasi-sdk",
    "geometry"
  ],
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./gltf-transform": {
      "types": "./src/gltf-transform.d.ts",
      "import": "./src/gltf-transform.js"
    },
    "./pmp.wasm": "./dist/pmp.wasm",
    "./include/pmp.h": "./include/pmp.h"
  },
  "peerDependencies": {
    "@gltf-transform/core": "^4.5.1"
  },
  "peerDependenciesMeta": {
    "@gltf-transform/core": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kzhsw/pmp-wasi.git"
  },
  "homepage": "https://github.com/kzhsw/pmp-wasi#readme",
  "bugs": {
    "url": "https://github.com/kzhsw/pmp-wasi/issues"
  },
  "sideEffects": false
}
